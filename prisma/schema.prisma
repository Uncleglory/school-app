generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────── ENUMS ─────────

enum Role {
  ADMIN
  TEACHER
  STAFF
  STUDENT
  PARENT
  LIBRARIAN
  ACCOUNTANT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  SUSPENDED
  WITHDRAWN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  HALF_DAY
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MOBILE_MONEY
  CHEQUE
}

enum MaterialType {
  NOTE
  ASSIGNMENT
  SLIDE
  PAST_PAPER
  VIDEO
  OTHER
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

enum NotificationType {
  ABSENCE_ALERT
  STAFF_ABSENCE_ALERT
  FEE_REMINDER
  PAYMENT_RECEIVED
  LIBRARY_DUE
  GENERAL
}

// ───────── USERS & AUTH ─────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  role         Role
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  staff             Staff?
  student           Student?
  parent            Parent?
  notifications     Notification[]
  materials         TeachingMaterial[]
  paymentsReceived  Payment[]
  loans             BookLoan[]
  markedAttendances StudentAttendance[] @relation("MarkedBy")
  examResultsEntered ExamResult[]
}

// ───────── ACADEMIC STRUCTURE ─────────

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique // "2025/2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  terms         Term[]
  feeStructures FeeStructure[]
  exams         Exam[]
}

model Term {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean      @default(false)

  invoices      Invoice[]
  feeStructures FeeStructure[]
  exams         Exam[]

  @@unique([academicYearId, name])
}

model Class {
  id            String  @id @default(cuid())
  name          String  @unique // "Grade 7A"
  level         String  // "Grade 7"
  capacity      Int     @default(40)
  formTeacherId String?
  formTeacher   Staff?  @relation(fields: [formTeacherId], references: [id])

  students      Student[]
  subjects      ClassSubject[]
  materials     TeachingMaterial[]
  feeStructures FeeStructure[]
}

model Subject {
  id   String @id @default(cuid())
  name String
  code String @unique

  classes   ClassSubject[]
  materials TeachingMaterial[]
  results   ExamResult[]
}

model ClassSubject {
  id        String  @id @default(cuid())
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Staff?  @relation("SubjectTeacher", fields: [teacherId], references: [id])

  @@unique([classId, subjectId])
}

// ───────── PEOPLE ─────────

model Staff {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffNo    String    @unique
  department String?
  position   String? // "Teacher", "Bursar", "Cleaner"
  hireDate   DateTime
  salary     Float?
  isTeaching Boolean   @default(false)

  formClasses   Class[]
  teaching      ClassSubject[] @relation("SubjectTeacher")
  attendance    StaffAttendance[]
  leaveRequests LeaveRequest[]
}

model Student {
  id          String        @id @default(cuid())
  userId      String?       @unique
  user        User?         @relation(fields: [userId], references: [id])
  admissionNo String        @unique
  firstName   String
  lastName    String
  otherName   String?
  gender      Gender
  dateOfBirth DateTime
  address     String?
  photoUrl    String?
  classId     String?
  class       Class?        @relation(fields: [classId], references: [id])
  status      StudentStatus @default(ACTIVE)
  admittedAt  DateTime      @default(now())

  guardians  ParentStudent[]
  attendance StudentAttendance[]
  invoices   Invoice[]
  examResults ExamResult[]
}

model Parent {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationship String // "Father" | "Mother" | "Guardian"
  occupation   String?

  children ParentStudent[]
}

model ParentStudent {
  id        String  @id @default(cuid())
  parentId  String
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  isPrimary Boolean @default(false)

  @@unique([parentId, studentId])
}

// ───────── ATTENDANCE ─────────

model StudentAttendance {
  id         String           @id @default(cuid())
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  note       String?
  markedById String?
  markedBy   User?            @relation("MarkedBy", fields: [markedById], references: [id])
  createdAt  DateTime         @default(now())

  @@unique([studentId, date])
  @@index([date])
}

model StaffAttendance {
  id       String           @id @default(cuid())
  staffId  String
  staff    Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date     DateTime         @db.Date
  checkIn  DateTime?
  checkOut DateTime?
  status   AttendanceStatus
  note     String?

  @@unique([staffId, date])
  @@index([date])
}

model LeaveRequest {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type      String
  startDate DateTime
  endDate   DateTime
  reason    String
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())
}

// ───────── FEES & FINANCE ─────────

model FeeStructure {
  id             String       @id @default(cuid())
  name           String // "Grade 7 – Term 1 Tuition"
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  termId         String?
  term           Term?        @relation(fields: [termId], references: [id])
  classId        String?
  class          Class?       @relation(fields: [classId], references: [id])
  amount         Decimal      @db.Decimal(12, 2)
  dueDate        DateTime
  autoGenerate   Boolean      @default(true)

  invoices Invoice[]
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique // INV-2025-00001
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id])
  termId         String?
  term           Term?         @relation(fields: [termId], references: [id])
  description    String?
  amount         Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  status         InvoiceStatus @default(UNPAID)
  dueDate        DateTime
  issuedAt       DateTime      @default(now())

  payments Payment[]
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receiptNo    String        @unique // RCP-2025-00001
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  reference    String?
  note         String?
  paidAt       DateTime      @default(now())
  receivedById String?
  receivedBy   User?         @relation(fields: [receivedById], references: [id])
}

// ───────── LIBRARY ─────────

model Book {
  id              String  @id @default(cuid())
  isbn            String? @unique
  title           String
  author          String
  category        String?
  totalCopies     Int     @default(1)
  availableCopies Int     @default(1)
  shelfLocation   String?
  coverUrl        String?

  loans BookLoan[]
}

model BookLoan {
  id         String     @id @default(cuid())
  bookId     String
  book       Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  borrowerId String
  borrower   User       @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  borrowedAt DateTime   @default(now())
  dueDate    DateTime
  returnedAt DateTime?
  fine       Decimal    @default(0) @db.Decimal(10, 2)
  status     LoanStatus @default(ACTIVE)
}

// ───────── TEACHER MATERIALS ─────────

model TeachingMaterial {
  id                String       @id @default(cuid())
  title             String
  description       String?
  type              MaterialType @default(NOTE)
  fileUrl           String
  classId           String?
  class             Class?       @relation(fields: [classId], references: [id])
  subjectId         String?
  subject           Subject?     @relation(fields: [subjectId], references: [id])
  uploadedById      String
  uploadedBy        User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  visibleToStudents Boolean      @default(true)
  createdAt         DateTime     @default(now())
}

// ───────── NOTIFICATIONS / ALERTS ─────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

// ───────── EXAMS & RESULTS ─────────

enum ExamType {
  CONTINUOUS_ASSESSMENT
  MID_TERM
  FINAL
  MOCK
  OTHER
}

model Exam {
  id             String    @id @default(cuid())
  name           String    // "First Term Mid-Term Exam"
  type           ExamType  @default(MID_TERM)
  termId         String?
  term           Term?     @relation(fields: [termId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  startDate      DateTime
  endDate        DateTime
  isPublished    Boolean   @default(false)
  createdAt      DateTime  @default(now())

  results ExamResult[]
}

model ExamResult {
  id          String  @id @default(cuid())
  examId      String
  exam        Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id])
  score       Decimal @db.Decimal(5, 2)
  maxScore    Decimal @default(100) @db.Decimal(5, 2)
  grade       String? // A, B, C, D, E, F
  remark      String?
  enteredById String?
  enteredBy   User?   @relation(fields: [enteredById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([examId, studentId, subjectId])
  @@index([studentId])
  @@index([examId])
}

// ───────── SCHOOL SETTINGS ─────────

model SchoolSettings {
  id          String  @id @default(cuid())
  name        String  @default("My School")
  motto       String?
  address     String?
  phone       String?
  email       String?
  website     String?
  logoUrl     String?
  principal   String?
  updatedAt   DateTime @updatedAt
}
