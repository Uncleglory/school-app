# ───────── Database (PostgreSQL) ─────────
# Local: postgresql://user:password@localhost:5432/schooldb
# Neon (recommended for Vercel): paste from console.neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ───────── Auth.js ─────────
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Production URL (set these on Vercel)
# AUTH_URL="https://your-app.vercel.app"
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# ───────── Email (Resend) ─────────
# Free at https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxx"
# Testing: onboarding@resend.dev  |  Production: your verified domain
EMAIL_FROM="School App <onboarding@resend.dev>"

# ───────── SMS (Africa's Talking – optional) ─────────
# https://account.africastalking.com
AT_API_KEY=""
AT_USERNAME="sandbox"
